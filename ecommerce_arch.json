    { "id": "storage-to-controller", "from": "local-storage", "to": "getx-controller", "label": "Retrieve stored data" },
    { "id": "ui-to-assets", "from": "ui-screens", "to": "asset-manager", "label": "Load images/fonts" },
    { "id": "ui-to-theme", "from": "ui-screens", "to": "theme-engine", "label": "Apply theme" },
    { "id": "ui-to-auth", "from": "ui-screens", "to": "auth-service", "label": "Login/signup requests" },
    { "id": "auth-to-ui", "from": "auth-service", "to": "ui-screens", "label": "Auth tokens/responses" }
  ],
  "cards": [
    { "dot": "cyan", "title": "UI Screens", "items": ["LoginScreen", "SignupScreen", "HomeScreen", "ProductDetailScreen"] },
